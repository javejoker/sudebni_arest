        "did_not_receive_claim": {
          "enum": [
            "confirmed",
            "unknown",
            "contradicted"
          ]
        },
        "could_not_present_objections": {
          "enum": [
            "confirmed",
            "unknown",
            "contradicted"
          ]
        },
        "learned_from_bailiff": {
          "enum": [
            "confirmed",
            "unknown",
            "contradicted"
          ]
        },
        "will_provide_relevant_evidence": {
          "enum": [
            "confirmed",
            "unknown",
            "contradicted"
          ]
        },
        "missed_deadline": {
          "enum": [
            "confirmed",
            "unknown",
            "contradicted"
          ]
        }
      },
      "additionalProperties": false
