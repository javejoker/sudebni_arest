    "act_type": {
      "type": "string",
      "enum": [
        "simplified_written_decision",
        "other",
        "unknown"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "court_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "court_address": {
          "type": [
            "string",
            "null"
          ]
        },
        "court_instrumental": {
          "type": [
            "string",
            "null"
          ]
        },
        "court_genitive": {
          "type": [
            "string",
            "null"
          ]
        },
        "case_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "awareness_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "filing_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "plaintiff_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "plaintiff_genitive": {
          "type": [
            "string",
            "null"
          ]
        },
        "plaintiff_iin": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{12}$"
        },
        "plaintiff_bin": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{12}$"
        },
        "plaintiff_address": {
          "type": [
            "string",
            "null"
          ]
        },
        "defendant_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "defendant_dative": {
          "type": [
            "string",
            "null"
          ]
        },
        "defendant_iin": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{12}$"
        },
        "defendant_address": {
          "type": [
            "string",
            "null"
          ]
        },
        "defendant_phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "defendant_email": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount_words": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "facts": {
      "type": "object",
      "properties": {
        "not_properly_notified": {
          "enum": [
            "confirmed",
            "unknown",
            "contradicted"
